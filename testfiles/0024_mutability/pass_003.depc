func f(i32_t mutable x, ref_t(i32_t, scopeof(x)) mutable p) -> i32_t
{
    if (*p < 10)
        x = 11;
    return x;
}

func g(i32_t a) -> i32_t
{
    // similar to `typecheck_error_010.depc` but `p` is a referencing to `a` which is immutable, which is ok
    return f(a, &a);
}
