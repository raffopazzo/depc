func f(i32_t mutable x, ref_t(i32_t, scopeof(x)) mutable p) -> i32_t
{
    if (*p < 10)
        x = 11;
    return x;
}

func f2(i32_t mutable x, i32_t mutable y) -> i32_t
{
    if (y == 0)
    {
        x = 10;
        y = 11;
    }
    return x + y;
}

func g(i32_t a) -> i32_t
{
    // similar to `typecheck_error_010.depc` but `p` is a reference to `a` which is immutable, which is ok
    return f(a, &a);
}
