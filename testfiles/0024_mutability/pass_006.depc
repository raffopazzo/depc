struct t
{
    i32_t x;
    i32_t y;
};

func f(t mutable x, ref_t(i32_t, scopeof(x)) mutable p) -> i32_t
{
    if (*p < 10)
        x.x = 11;
    return x.x;
}

func g(t x) -> i32_t
{
    // similar to `typecheck_error_014.depc` but `p` is a reference to `x.x` which is immutable, which is ok
    return f(x, &x.x);
}
