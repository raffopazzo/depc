func f0(0 scope_t a, ref_t(i32_t, a) p) -> i32_t
{
    return *p;
}

func f1(i32_t mutable x) -> i32_t
{
    immutable(x)
    {
        return f0(scopeof(x), &x);
    }
}
func f2(i32_t mutable x, i32_t mutable y) -> i32_t
{
    immutable(x, y)
    {
        return f0(scopeof(x), &x) + f0(scopeof(y), &y);
    }
}
