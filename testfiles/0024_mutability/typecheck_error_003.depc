func make_array() -> array_t(i32_t, 3) { return {1,2,3}; }
func f(array_t(i32_t, 3) xs) -> array_t(i32_t, 3)
{
    make_array()[0] = xs[1]; // typecheck error: assignment target not rooted in a mutable variable
    return xs;
}
