struct t
{
    u64_t n;
};

func f(t mutable x, array_t(i32_t, x.n) xs) -> i32_t
{
    x.n = 1;
    if (0 < x.n)
        return xs[0]; // typecheck error: cannot verify that access within bounds, because x.n has been modified now
    else
        return 0;
}
