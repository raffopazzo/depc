func f((u64_t, i64_t) mutable x, array_t(i32_t, x[0]) xs) -> i32_t
{
    x[0] = 1;
    if (0 < x[0])
        return xs[0]; // typecheck error: cannot verify that access within bounds, because x[0] has been modified now
    else
        return 0;
}
