// func f(i32_t mutable x, i32_t mutable y) -> i32_t
// {
//     auto p = &y; // typecheck error: cannot take reference to a mutable variable
//     if (*p < 10)
//         y = 11; // because otherwise we might break proofs about those references
// 
//     x = *&y; // typecheck error: cannot take reference to a mutable variable
//     return x;
