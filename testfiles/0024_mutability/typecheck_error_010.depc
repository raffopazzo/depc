func f(i32_t mutable x, ref_t(i32_t, scopeof(x)) mutable p) -> i32_t
{
    p = &x; // typecheck error: cannot take reference to a mutable variable
    if (*p < 10)
        x = 11; // because otherwise we might break proofs about those references
    return x;
}

func g(i32_t x) -> i32_t
{
    return f(x, &x);
}
