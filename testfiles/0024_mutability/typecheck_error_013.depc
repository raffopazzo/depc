func f(array_t(i32_t, 2) mutable x, ref_t(i32_t, scopeof(x)) mutable p) -> i32_t
{
    p = &x[0]; // typecheck error: cannot take reference to an element rooted in a mutable variable
    if (*p < 10)
        x[0] = 11; // because otherwise we might break proofs about those references
    return x[0];
}

func g(array_t(i32_t, 2) x) -> i32_t
{
    return f(x, &x[0]);
}
