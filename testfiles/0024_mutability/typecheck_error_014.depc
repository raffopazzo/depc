struct t
{
    i32_t x;
    i32_t y;
};

func f(t mutable x, ref_t(i32_t, scopeof(x)) mutable p) -> i32_t
{
    p = &x.x; // typecheck error: cannot take reference to field rooted in a mutable variable
    if (*p < 10)
        x[0] = 11;
    return x[0];
}

func g(t x) -> i32_t
{
    return f(x, &x.x);
}
