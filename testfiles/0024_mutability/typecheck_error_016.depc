func f(i32_t mutable x, ref_t(i32_t, scopeof(x)) mutable p) -> i32_t
{
    immutable(x)
    {
        p = &x; // typecheck error: the scope of the immutable x is smaller than the mutable one
    }
    return *p; // otherwise `p` could now refer to the mutable `x`, which must not be allowed
}
